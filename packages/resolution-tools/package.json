{
  "name": "@resolveforge/resolution-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "tsx src/bootstrap.ts",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json"
  },
  "dependencies": {
    "@1jehuang/jcode-sdk": "latest",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
