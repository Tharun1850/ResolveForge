{
  "name": "@resolveforge/demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "pnpm run \"/^(dev:api|dev:web)$/\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scan": "latest",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3"
  }
}
